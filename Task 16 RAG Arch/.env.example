# Example environment file for Task 16 RAG Arch
# Copy this to .env and fill in the actual values.

# LLM API keys (example for OpenAI or OpenRouter)
OPENAI_API_KEY=your_openai_api_key_here
# If using OpenRouter, you can also set:
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: API base URLs (if needed)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Other configuration (if not in model_config.yaml)
# CHROMA_PERSIST_DIRECTORY=./chroma_db
# CHROMA_COLLECTION_NAME=support_tickets
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-5.6-luna
# TOP_K=4